{
  "manifest_version": 3,
  "name": "Jarvis Browser Bridge",
  "version": "0.1.2",
  "description": "Lets your AI assistant drive your own Chrome \u2014 your IP, your logins \u2014 under permissions you control. Private v1.",
  "minimum_chrome_version": "114",
  "host_permissions": [
    "<all_urls>"
  ],
  "permissions": [
    "activeTab",
    "alarms",
    "sidePanel",
    "storage",
    "tabs",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Jarvis Browser Bridge"
  },
  "commands": {
    "kill-session": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Kill the bridge session immediately (no confirmation)"
    }
  }
}